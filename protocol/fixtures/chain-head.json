{
  "topic": "Resolving the head of an edit chain",
  "rule": "docs/protocol.md#resolving-the-head-of-a-chain",
  "$comment": "Every link is by the same author, so the ordering is self-scoped: the author's own clock decides, and every implementation resolves the same head from the same set. Arrival order is irrelevant here.",
  "cases": [
    {
      "name": "linear chain of three versions",
      "why": "The common case. A listing must show the current version, never a superseded one.",
      "arrival": [
        {
          "id": "e1",
          "author": "alice",
          "type": "review.created",
          "at": "2026-01-01T10:00:00Z",
          "payload": {
            "entity": "cnpj:1",
            "rating": 2,
            "body": "v1"
          }
        },
        {
          "id": "e2",
          "author": "alice",
          "type": "review.replaced",
          "at": "2026-01-02T10:00:00Z",
          "payload": {
            "replaces": "e1",
            "rating": 3,
            "body": "v2"
          }
        },
        {
          "id": "e3",
          "author": "alice",
          "type": "review.replaced",
          "at": "2026-01-03T10:00:00Z",
          "payload": {
            "replaces": "e2",
            "rating": 4,
            "body": "v3"
          }
        }
      ],
      "expect": {
        "head": "e3",
        "chain": [
          "e1",
          "e2",
          "e3"
        ],
        "withdrawn": false,
        "truncated": false
      }
    },
    {
      "name": "fork resolved by higher createdAt",
      "why": "Two edits naming the same predecessor happen when a client publishes offline, unaware of the other. Without a rule, each implementation picks a different head.",
      "arrival": [
        {
          "id": "e1",
          "author": "alice",
          "type": "review.created",
          "at": "2026-01-01T10:00:00Z",
          "payload": {
            "entity": "cnpj:1",
            "rating": 2,
            "body": "v1"
          }
        },
        {
          "id": "e2a",
          "author": "alice",
          "type": "review.replaced",
          "at": "2026-01-02T10:00:00Z",
          "payload": {
            "replaces": "e1",
            "rating": 3,
            "body": "branch A"
          }
        },
        {
          "id": "e2b",
          "author": "alice",
          "type": "review.replaced",
          "at": "2026-01-05T10:00:00Z",
          "payload": {
            "replaces": "e1",
            "rating": 5,
            "body": "branch B"
          }
        }
      ],
      "expect": {
        "head": "e2b",
        "losingBranch": [
          "e2a"
        ],
        "withdrawn": false,
        "truncated": false
      }
    },
    {
      "name": "fork tied on createdAt, broken by lower eventId",
      "why": "The tiebreak has to be deterministic and clock-free, otherwise arrival order decides and two nodes diverge.",
      "arrival": [
        {
          "id": "e1",
          "author": "alice",
          "type": "review.created",
          "at": "2026-01-01T10:00:00Z",
          "payload": {
            "entity": "cnpj:1",
            "rating": 2,
            "body": "v1"
          }
        },
        {
          "id": "e2z",
          "author": "alice",
          "type": "review.replaced",
          "at": "2026-01-02T10:00:00Z",
          "payload": {
            "replaces": "e1",
            "rating": 3,
            "body": "branch Z"
          }
        },
        {
          "id": "e2a",
          "author": "alice",
          "type": "review.replaced",
          "at": "2026-01-02T10:00:00Z",
          "payload": {
            "replaces": "e1",
            "rating": 4,
            "body": "branch A"
          }
        }
      ],
      "expect": {
        "head": "e2a",
        "losingBranch": [
          "e2z"
        ],
        "tiebreak": "lexicographically lower id",
        "withdrawn": false,
        "truncated": false
      }
    },
    {
      "name": "reversed arrival order does not change the head",
      "why": "This rule is self-scoped and must be immune to observation order. If the head shifts with arrival order, the projection has stopped being deterministic.",
      "arrival": [
        {
          "id": "e3",
          "author": "alice",
          "type": "review.replaced",
          "at": "2026-01-03T10:00:00Z",
          "payload": {
            "replaces": "e2",
            "rating": 4,
            "body": "v3"
          }
        },
        {
          "id": "e1",
          "author": "alice",
          "type": "review.created",
          "at": "2026-01-01T10:00:00Z",
          "payload": {
            "entity": "cnpj:1",
            "rating": 2,
            "body": "v1"
          }
        },
        {
          "id": "e2",
          "author": "alice",
          "type": "review.replaced",
          "at": "2026-01-02T10:00:00Z",
          "payload": {
            "replaces": "e1",
            "rating": 3,
            "body": "v2"
          }
        }
      ],
      "expect": {
        "head": "e3",
        "chain": [
          "e1",
          "e2",
          "e3"
        ],
        "note": "identical to the linear case, despite the order"
      }
    },
