# Postgres the projections live in; the role and databases come from
# infra/local (configs/postgres/init/02-indexer.sh).
DATABASE_URL=postgres://indexer:goodpassword@127.0.0.1:5432/ecoa_indexer?sslmode=disable

# Comma-separated gRPC addresses of the nodes `project` follows.
NODE_ADDRS=127.0.0.1:50051

# host:port the HTTP API answers on.
HTTP_ADDR=127.0.0.1:8081

# JSON file of the moderators whose labels count when a request names none
# in ?moderators=; empty follows nobody.
MODERATORS_FILE=

# JSON file of the verifiers whose delegated claims (human) count; empty
# recognizes none. infra/local's lists the local gateway's verifier key.
VERIFIERS_FILE=

# How `project` looks up domain claims: DNS-over-HTTPS through DOH_URL, or
# plain DNS through DNS_SERVER (host:port) when it is set.
DOH_URL=https://cloudflare-dns.com/dns-query
DNS_SERVER=

# How the API orders an entity's reviews: newest or endorsed.
RANKING=newest
