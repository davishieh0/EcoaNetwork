# --- postgres ---
# superuser password, for administration only
# POSTGRES_PASSWORD=postgres

# backend database password
# BACKEND_DB_PASSWORD=goodpassword

# indexer database password
# INDEXER_DB_PASSWORD=goodpassword

# --- indexer ---
# how its API orders an entity's reviews: newest or endorsed
# RANKING=newest

# --- backend ---
# its port on this machine, when 8000 is taken
# BACKEND_PORT=8000
