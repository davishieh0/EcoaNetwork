# general
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# server binding
BIND=0.0.0.0
PORT=8000

# cors (comma-separated, ':*' matches any port)
CORS_ORIGINS=http://localhost:*

# database
DATABASE_URL=postgresql+asyncpg://backend:goodpassword@localhost:5432/ecoa_backend

# aws (the endpoint is only set when pointing at LocalStack)
AWS_REGION=sa-east-1
AWS_ENDPOINT_URL=

# cognito (the issuer is only set when pointing at LocalStack)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=

# cookies ('false' only for local http)
COOKIE_SECURE=false

# nodes the gateway publishes to (comma-separated host:port, primary first)
NODE_ADDRS=localhost:50051

# the indexer's read API, which the read routes pass on
INDEXER_URL=http://localhost:8081

# the network events are signed for; the nodes' NETWORK
ECOA_NETWORK=ecoa-dev

# the human verifier's Ed25519 seed, 64 hex characters; empty issues no
# human claim. Its did:key must be in the indexer's VERIFIERS_FILE.
HUMAN_VERIFIER_SEED=

# signs the proof-of-work checks it hands out; empty picks a random one at
# each start, which voids the checks given out before a restart
ALTCHA_HMAC_SECRET=
