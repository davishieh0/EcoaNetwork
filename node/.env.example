# Network this node belongs to: ecoa, or ecoa-<name>.
NETWORK=ecoa-dev

# Multiaddr to listen on.
LISTEN_ADDR=/ip4/127.0.0.1/tcp/4001

# host:port the gateway submits events to.
GRPC_ADDR=127.0.0.1:50051

# Comma-separated peer multiaddrs; replaces the embedded list when set.
BOOTSTRAP_ADDRS=

# Path to the bbolt file holding the event log.
BOLT_DB_PATH=data/bbolt/bolt.db
